{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "ignorePaths": [
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    ".wrangler",
    ".impeccable",
    "worker-configuration.d.ts"
  ],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "en,en-GB",
  "overrides": [
    {
      "filename": [
        "**/i18n/dictionary-fr.ts",
        "PRODUCT.md",
        "DESIGN.md",
        "**/encounter/encounter-formats.ts"
      ],
      "language": "en,en-GB,fr"
    },
    {
      "filename": [
        "**/infrastructure/smartping/**",
        "**/scripts/smartping-init.ts",
        "**/protocol/src/federation.ts",
        "**/.dev.vars.example"
      ],
      "language": "en,en-GB,fr"
    }
  ],
