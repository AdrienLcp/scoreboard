{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "ignorePaths": [
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    ".wrangler",
    ".impeccable",
    "worker-configuration.d.ts"
  ],
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "language": "en,en-GB",
  "overrides": [
    {
      "filename": [
        "**/i18n/dictionary-fr.ts",
        "PRODUCT.md",
        "**/encounter/encounter-formats.ts"
      ],
      "language": "en,en-GB,fr"
    }
  ],
  "version": "0.2",
  "words": [
    "ABCDEFGHJKLM",
    "ABCDEFGHJKLMNPQRSTUVWXYZ",
    "abcdefghjkmnpqrstuvwxyz",
    "adrienlcp",
    "Arimo",
    "biomejs",
    "CDTT",
    "CNIL",
    "esbuild",
    "fftt",
    "FFTT",
    "fieldset",
    "focusables",
    "frontmatter",
    "GHJKLM",
    "Huet",
    "IHDR",
    "Inès",
    "ITTF",
    "Lacourpaille",
    "LCEN",
    "Léna",
    "linecap",
    "linejoin",
    "lnum",
    "minmax",
    "nowrap",
    "nums",
    "oklch",
    "overscroll",
    "partysocket",
    "pineau",
    "Pineau",
    "PQRSTUVWXYZ",
    "RGPD",
    "rhysd",
    "Rivière",
    "Segoe",
    "suivre",
    "tabindex",
    "tnum",
    "workerd",
    "Yanis"
  ]
}
